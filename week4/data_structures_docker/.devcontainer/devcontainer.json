{
    "name": "Jungle Week 4 - Data Structures",
    "dockerFile": "Dockerfile",
    "remoteUser": "jungle",
    "postCreateCommand": "git config --global --add safe.directory /workspaces/jungleweek4-5",
    "workspaceMount": "\"source=${localWorkspaceFolder}/../..\",target=/workspaces/jungleweek4-5,type=bind",
    "workspaceFolder": "/workspaces/jungleweek4-5/week4/data_structures_docker",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools"
                // "ms-vscode.cmake-tools",
                // "ms-vscode.makefile-tools"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "C_Cpp.default.includePath": [
                    "/usr/include",
                    "/usr/local/include"
                ],
                "C_Cpp.default.compilerPath": "/usr/bin/gcc"
            }
        }
    }
}